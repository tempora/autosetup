{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autosetup",
  "version": "0.3.0",
  "identifier": "dev.autosetup.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "autosetup",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/autosetup-server/": "server/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
